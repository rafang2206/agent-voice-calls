# Telnyx
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_STREAM_URL=wss://your-public-domain.example/ws
TELNYX_STREAM_TRACK=inbound_track
TELNYX_STREAM_CODEC=L16

# STT
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=u3-rt-pro

# Agente LangChain
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
# Saludo fijo al atender. Déjalo vacío para desactivarlo; no consume LLM.
AGENT_GREETING="Hola, ¿en qué te puedo ayudar?"
AGENT_SYSTEM_PROMPT="Eres un asistente telefónico profesional y amable. Responde siempre en español, de forma breve y natural para ser escuchada por voz."

# TTS streaming (Natural/NaturalHD soportan salida PCM por WebSocket)
TTS_PROVIDER=telnyx
TTS_VOICE=Telnyx.NaturalHD.astra
TTS_AUDIO_FORMAT=pcm
# Debe coincidir con la frecuencia PCM que entregue la voz seleccionada.
TTS_PCM_SAMPLE_RATE=24000
TTS_LANGUAGE=es-US
TTS_SERVICE_LEVEL=premium

# Alternativa: AssemblyAI Streaming TTS.
# Establece TTS_PROVIDER=assemblyai y usa el ID de una voz compatible con español.
TTS_ASSEMBLYAI_VOICE_ID=
# Vacío usa el idioma nativo de la voz; si se configura, usa el valor admitido
# por la voz seleccionada, por ejemplo spanish.
TTS_ASSEMBLYAI_LANGUAGE=
TTS_ASSEMBLYAI_REGION=us

# Alternativa: ElevenLabs Streaming TTS.
# Establece TTS_PROVIDER=elevenlabs y define ELEVENLABS_API_KEY.
ELEVENLABS_API_KEY=
TTS_ELEVENLABS_VOICE_ID=
TTS_ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_ELEVENLABS_OUTPUT_FORMAT=pcm_24000
# Opcional; multilingual_v2 no requiere language_code.
TTS_ELEVENLABS_LANGUAGE_CODE=
TTS_ELEVENLABS_INACTIVITY_TIMEOUT=180

# Privacidad: mantener en false fuera de depuración controlada.
LOG_TRANSCRIPTS=false
